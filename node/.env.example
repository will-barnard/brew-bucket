# Copy to .env on the NAS. scripts/nas-deploy.sh will do this for you.

# Where blobs live on the NAS filesystem.
STORAGE_PATH=/volume1/brew-bucket

# Must match the control plane's NODE_SHARED_SECRET (Beachhead env var).
NODE_SHARED_SECRET=

# Must match the control plane's DIRECT_URL_SECRET. Leave blank to reuse
# NODE_SHARED_SECRET for presigned direct transfers.
DIRECT_URL_SECRET=

# Set false to refuse presigned direct transfers entirely (proxy-only mode).
DIRECT_ENABLED=true

# Bind to the LAN interface. Do not expose this port to the internet — the mini
# is the only public entry point.
BIND_ADDRESS=0.0.0.0
HOST_PORT=8477
