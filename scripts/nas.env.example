# Copy to scripts/nas.env (gitignored) and fill in.
# Everything the deploy scripts need to reach and configure the NAS.

# SSH target for the NAS.
NAS_HOST=nas.lan
NAS_USER=admin
NAS_PORT=22
# Optional: identity file, useful when the NAS has its own key.
# NAS_SSH_KEY=~/.ssh/id_nas

# Where the deploy scripts put compose + .env on the NAS.
NAS_APP_DIR=/volume1/docker/brew-bucket

# Where blob data lives on the NAS. Put this on the big volume.
NAS_STORAGE_PATH=/volume1/brew-bucket

# Must match the control plane's env vars in the Beachhead dashboard.
NODE_SHARED_SECRET=
DIRECT_URL_SECRET=

# LAN port the storage node listens on. Never forward this at the router.
HOST_PORT=8477
BIND_ADDRESS=0.0.0.0
DIRECT_ENABLED=true

# Some NAS boxes need the full path; `which docker` over ssh often comes back
# empty because the login shell is non-interactive.
NAS_DOCKER=docker
